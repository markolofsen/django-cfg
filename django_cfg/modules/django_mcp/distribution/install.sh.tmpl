#!/bin/sh
# Connects Claude Code, Codex and Gemini CLI to an MCP server and installs its agent skill.
# Generated by django-cfg; only the three values below differ between servers.
#
#   curl -fsSL @@URL_RAW@@install.sh | sh
#   ... | sh -s -- --dry-run     print what would happen, change nothing
#   ... | sh -s -- --uninstall   remove the registration and the skill
#   ... | sh -s -- --no-skill    register the server only
#   ... | sh -s -- --force       overwrite a skill file that differs
set -eu

ALIAS=@@ALIAS@@
NAME=@@NAME@@
URL=@@URL@@
AUTH=@@AUTH@@   # oauth: sign in on first use. key: read from $MCP_API_KEY.
HEADER=X-MCP-Access-Key

DRY=0 UNINSTALL=0 SKILL=1 FORCE=0 FAILED=0 KEY= TMP= ECHO_OFF=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  GREEN=$(printf '\033[32m') RED=$(printf '\033[31m') YELLOW=$(printf '\033[33m') BOLD=$(printf '\033[1m') OFF=$(printf '\033[0m')
else
  GREEN= RED= YELLOW= BOLD= OFF=
fi

ok()   { printf '%s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
note() { printf '  %s\n' "$*"; }
warn() { printf '%s!%s %s\n' "$YELLOW" "$OFF" "$*" >&2; }
fail() { printf '%s✗%s %s\n' "$RED" "$OFF" "$*" >&2; FAILED=1; }
die()  { printf '%s✗%s %s\n' "$RED" "$OFF" "$*" >&2; exit "${2:-1}"; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<USAGE
Usage: curl -fsSL ${URL}install.sh | sh -s -- [options]

  --dry-run     print what would happen, change nothing
  --uninstall   remove the $ALIAS registration and its skill
  --no-skill    do not install the agent skill
  --force       overwrite a skill file that differs
USAGE
}

for arg in "$@"; do
  case $arg in
    --dry-run) DRY=1 ;;
    --uninstall) UNINSTALL=1 ;;
    --no-skill) SKILL=0 ;;
    --force) FORCE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $arg" 2 ;;
  esac
done

: "${HOME:?HOME is not set}"
cleanup() {
  [ "$ECHO_OFF" = 1 ] && stty echo </dev/tty 2>/dev/null
  [ -n "$TMP" ] && rm -rf "$TMP"
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT TERM

HAVE_CLAUDE=0 HAVE_CODEX=0 HAVE_GEMINI=0
have claude && HAVE_CLAUDE=1
have codex && HAVE_CODEX=1
have gemini && HAVE_GEMINI=1
[ $((HAVE_CLAUDE + HAVE_CODEX + HAVE_GEMINI)) -gt 0 ] ||
  die "none of claude, codex or gemini is in PATH; install one of them and run this again"

CLAUDE_SKILLS=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills
# Codex and Gemini CLI both read this user-level folder.
AGENTS_SKILLS=$HOME/.agents/skills
CODEX_DIR=${CODEX_HOME:-$HOME/.codex}

# The key is needed before anything is written, so that a missing one stops the run cleanly.
read_key() {
  [ "$AUTH" = key ] && [ "$UNINSTALL" -eq 0 ] && [ "$DRY" -eq 0 ] || return 0
  KEY=${MCP_API_KEY:-}
  if [ -z "$KEY" ]; then
    # `curl | sh` has the script on stdin, so the person is reached through the terminal.
    if ( : </dev/tty ) 2>/dev/null; then
      printf '%s API key (input hidden): ' "$NAME" >/dev/tty
      stty -echo </dev/tty 2>/dev/null && ECHO_OFF=1
      IFS= read -r KEY </dev/tty || KEY=
      [ "$ECHO_OFF" = 1 ] && stty echo </dev/tty 2>/dev/null
      ECHO_OFF=0
      printf '\n' >/dev/tty
    else
      die "$NAME needs your API key and there is no terminal to ask on. Run: curl -fsSL ${URL}install.sh | MCP_API_KEY=<key> sh (nothing was changed)"
    fi
  fi
  case $KEY in
    ''|*[!A-Za-z0-9._~+/=-]*) die "the API key is empty or has characters a key never has (nothing was changed)" ;;
  esac
}

claude_do() {
  if [ "$UNINSTALL" -eq 1 ]; then
    if [ "$DRY" -eq 1 ]; then ok "claude: would remove $ALIAS"
    elif claude mcp remove --scope user "$ALIAS" >/dev/null 2>&1; then ok "claude: removed $ALIAS"
    else note "claude: $ALIAS was not registered"; fi
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then ok "claude: would add $ALIAS -> $URL (user scope)"; return 0; fi
  claude mcp remove --scope user "$ALIAS" >/dev/null 2>&1 || true
  if [ "$AUTH" = key ]; then
    # The CLI takes headers only as arguments; no other CLI option exists.
    claude mcp add --scope user --transport http "$ALIAS" "$URL" --header "$HEADER: $KEY" >/dev/null 2>&1 && ok "claude: added $ALIAS" || fail "claude: registration failed"
  else
    claude mcp add --scope user --transport http "$ALIAS" "$URL" >/dev/null 2>&1 && ok "claude: added $ALIAS" || fail "claude: registration failed"
  fi
}

gemini_do() {
  if [ "$UNINSTALL" -eq 1 ]; then
    if [ "$DRY" -eq 1 ]; then ok "gemini: would remove $ALIAS"
    elif gemini mcp remove --scope user "$ALIAS" >/dev/null 2>&1; then ok "gemini: removed $ALIAS"
    else note "gemini: $ALIAS was not registered"; fi
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then ok "gemini: would add $ALIAS -> $URL (user scope)"; return 0; fi
  gemini mcp remove --scope user "$ALIAS" >/dev/null 2>&1 || true
  if [ "$AUTH" = key ]; then
    gemini mcp add --scope user --transport http --header "$HEADER: $KEY" "$ALIAS" "$URL" >/dev/null 2>&1 && ok "gemini: added $ALIAS" || fail "gemini: registration failed"
  else
    gemini mcp add --scope user --transport http "$ALIAS" "$URL" >/dev/null 2>&1 && ok "gemini: added $ALIAS" || fail "gemini: registration failed"
  fi
}

# Codex's CLI cannot set HTTP headers, so the table goes into config.toml. The file is the
# person's own: only this server's table is touched, a backup is kept, and the result must
# be readable by `codex mcp get` or the old file is put back.
codex_strip() {
  awk -v a="$ALIAS" '
    /^[ \t]*\[/ {
      h = $0; sub(/^[ \t]*\[/, "", h); sub(/\][ \t]*(#.*)?$/, "", h); gsub(/"/, "", h)
      skip = (h == "mcp_servers." a || index(h, "mcp_servers." a ".") == 1)
    }
    skip { next }
    /^[ \t]*$/ { pending++; next }
    { while (pending > 0) { print ""; pending-- } print }
  ' "$1"
}

codex_do() {
  cfg=$CODEX_DIR/config.toml
  if [ "$UNINSTALL" -eq 1 ]; then
    if ! grep -Eq "^[[:space:]]*\\[mcp_servers\\.\"?$ALIAS\"?(\\.|\\])" "$cfg" 2>/dev/null; then
      note "codex: $ALIAS was not registered"; return 0
    fi
    if [ "$DRY" -eq 1 ]; then ok "codex: would remove [mcp_servers.$ALIAS] from $cfg"; return 0; fi
    codex_write "" && ok "codex: removed $ALIAS" || fail "codex: could not edit $cfg"
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then ok "codex: would write [mcp_servers.$ALIAS] to $cfg"; return 0; fi
  codex mcp remove "$ALIAS" >/dev/null 2>&1 || true
  if [ "$AUTH" = key ]; then
    block=$(printf '[mcp_servers.%s]\nurl = "%s"\nhttp_headers = { "%s" = "%s" }' "$ALIAS" "$URL" "$HEADER" "$KEY")
  else
    block=$(printf '[mcp_servers.%s]\nurl = "%s"' "$ALIAS" "$URL")
  fi
  codex_write "$block" && ok "codex: added $ALIAS ($cfg)" || fail "codex: could not edit $cfg"
}

codex_write() {
  mkdir -p "$CODEX_DIR" || return 1
  [ -f "$cfg" ] || : >"$cfg"
  backup=$cfg.bak-$(date +%Y%m%d-%H%M%S)
  cp -p "$cfg" "$backup" && chmod 600 "$backup" || return 1
  new=$cfg.tmp.$$
  ( umask 077
    codex_strip "$cfg" >"$new"
    if [ -n "$1" ]; then
      [ -s "$new" ] && printf '\n' >>"$new"
      printf '%s\n' "$1" >>"$new"
    fi ) || { rm -f "$new"; return 1; }
  mv "$new" "$cfg" || { rm -f "$new"; return 1; }
  chmod 600 "$cfg"
  if [ -n "$1" ] && ! codex mcp get "$ALIAS" >/dev/null 2>&1; then
    mv "$backup" "$cfg"
    warn "codex rejected the new entry; $cfg was put back as it was"
    return 1
  fi
  [ "$UNINSTALL" -eq 1 ] || note "codex: previous config kept as ${backup##*/}"
}

fetch() {
  if have curl; then curl -fsSL --max-time 30 -o "$2" "$1"
  elif have wget; then wget -q -T 30 -O "$2" "$1"
  else return 1; fi
}

# The skill is fetched once, checked to be a skill and not an error page, and copied.
skill_fetch() {
  [ "$SKILL" -eq 1 ] && [ "$UNINSTALL" -eq 0 ] && [ "$DRY" -eq 0 ] || return 0
  TMP=$(mktemp -d) || { warn "no temporary folder; the skill is not installed"; SKILL=0; return 0; }
  if fetch "${URL}SKILL.md" "$TMP/SKILL.md" 2>/dev/null && head -n 1 "$TMP/SKILL.md" | grep -q '^---' &&
     grep -q "^name: $ALIAS\$" "$TMP/SKILL.md"; then
    return 0
  fi
  warn "could not fetch ${URL}SKILL.md; the skill is not installed"
  SKILL=0
}

skill_do() {
  dir=$1/$ALIAS file=$1/$ALIAS/SKILL.md
  if [ "$UNINSTALL" -eq 1 ]; then
    [ -f "$file" ] || { note "skill: none at $file"; return 0; }
    if [ "$FORCE" -eq 1 ] || grep -q 'generated by django-cfg' "$file"; then
      [ "$DRY" -eq 1 ] && { ok "skill: would remove $file"; return 0; }
      rm -f "$file" && rmdir "$dir" 2>/dev/null; ok "skill: removed $file"
    else
      warn "skill: $file was not generated by django-cfg; left in place (--force removes it)"
    fi
    return 0
  fi
  if [ "$DRY" -eq 1 ]; then ok "skill: would write $file"; return 0; fi
  if [ -f "$file" ]; then
    if cmp -s "$TMP/SKILL.md" "$file"; then note "skill: $file is up to date"; return 0; fi
    if [ "$FORCE" -eq 0 ]; then warn "skill: $file differs; left in place (--force overwrites it)"; return 0; fi
  fi
  mkdir -p "$dir" && cp "$TMP/SKILL.md" "$file" && ok "skill: wrote $file" || fail "skill: could not write $file"
}

read_key
[ "$SKILL" -eq 0 ] || skill_fetch

[ "$HAVE_CLAUDE" -eq 0 ] || claude_do
[ "$HAVE_CODEX" -eq 0 ] || codex_do
[ "$HAVE_GEMINI" -eq 0 ] || gemini_do
if [ "$SKILL" -eq 1 ]; then
  [ "$HAVE_CLAUDE" -eq 0 ] || skill_do "$CLAUDE_SKILLS"
  if [ "$HAVE_CODEX" -eq 1 ] || [ "$HAVE_GEMINI" -eq 1 ]; then skill_do "$AGENTS_SKILLS"; fi
fi

[ "$FAILED" -eq 0 ] || die "finished with errors"
[ "$DRY" -eq 0 ] || { printf '%sDry run: nothing was changed.%s\n' "$BOLD" "$OFF"; exit 0; }
[ "$UNINSTALL" -eq 0 ] || exit 0

printf '\n%s%s is connected.%s Check it:\n' "$BOLD" "$NAME" "$OFF"
[ "$HAVE_CLAUDE" -eq 0 ] || note "claude mcp get $ALIAS"
[ "$HAVE_CODEX" -eq 0 ] || note "codex mcp get $ALIAS"
[ "$HAVE_GEMINI" -eq 0 ] || note "gemini mcp list"
if [ "$AUTH" = oauth ]; then
  printf 'Sign in on first use:\n'
  [ "$HAVE_CLAUDE" -eq 0 ] || note "Claude Code: open /mcp, pick $ALIAS, sign in"
  [ "$HAVE_CODEX" -eq 0 ] || note "Codex: codex mcp login $ALIAS"
  [ "$HAVE_GEMINI" -eq 0 ] || note "Gemini CLI: /mcp auth $ALIAS"
fi
