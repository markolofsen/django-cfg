{
  "name": "@djangocfg/widget-code",
  "version": "0.1.24",
  "description": "Code surfaces: a Monaco editor, a diff viewer, a JSON editor and the markdown renderer that embeds them",
  "keywords": [
    "code-editor",
    "monaco",
    "diff",
    "syntax-highlighting",
    "markdown",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/code"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./editor": {
      "types": "./src/editor/lazy.tsx",
      "default": "./src/editor/lazy.tsx"
    },
    "./json-editor": {
      "types": "./src/json-editor/lazy.tsx",
      "default": "./src/json-editor/lazy.tsx"
    },
    "./diff-viewer": {
      "types": "./src/diff-viewer/lazy.tsx",
      "default": "./src/diff-viewer/lazy.tsx"
    },
    "./diff-viewer/full": {
      "types": "./src/diff-viewer/index.ts",
      "default": "./src/diff-viewer/index.ts"
    },
    "./markdown-message": {
      "types": "./src/markdown-message/index.ts",
      "default": "./src/markdown-message/index.ts"
    },
    "./role-tokens": {
      "types": "./src/role-tokens.ts",
      "default": "./src/role-tokens.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djangocfg/widget-data": "workspace:*",
    "@djangocfg/widget-diagram": "workspace:*",
    "@djangocfg/widget-editor": "workspace:*",
    "@djangocfg/widget-kit": "workspace:*",
    "json-edit-react": "^2.0.5",
    "monaco-editor": "^0.57.0",
    "prism-react-renderer": "^2.4.1",
    "react-markdown": "10.1.0",
    "react-virtuoso": "^4.18.20",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "4.0.1",
    "remark-smartypants": "^3.0.3"
  },
  "peerDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
