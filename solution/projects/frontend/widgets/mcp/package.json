{
  "name": "@djangocfg/widget-mcp",
  "version": "0.4.41",
  "description": "Connect an AI assistant to a django-cfg MCP server in one press, with the user's own key; plus the OAuth consent page. 17 locales.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "codex",
    "cursor",
    "vscode",
    "oauth",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./marks": "./src/marks.tsx"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/stories",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "next": ">=15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
