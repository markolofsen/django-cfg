{
  "name": "@djangocfg/widget-map",
  "version": "0.1.37",
  "description": "Interactive maps on MapLibre GL: markers, clustered GeoJSON, layer factories, key-free basemaps, terrain, geocoding and measuring behind one provider",
  "keywords": [
    "map",
    "maplibre",
    "geojson",
    "clustering",
    "pmtiles",
    "geocoder",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/map"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./eager": {
      "types": "./src/eager.ts",
      "default": "./src/eager.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djangocfg/widget-kit": "workspace:*",
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "react-map-gl": "^8.1.3"
  },
  "peerDependencies": {
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@storybook/react-vite": "^10.6.5",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
