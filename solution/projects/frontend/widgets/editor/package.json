{
  "name": "@djangocfg/widget-editor",
  "version": "0.1.125",
  "description": "TipTap editors: a markdown field with mentions and chips, and a Notion-style block editor with slash commands, tables and embedded blocks",
  "keywords": [
    "editor",
    "tiptap",
    "markdown",
    "wysiwyg",
    "notion",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/editor"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown/lazy.tsx",
      "default": "./src/markdown/lazy.tsx"
    },
    "./notion": {
      "types": "./src/notion/lazy.tsx",
      "default": "./src/notion/lazy.tsx"
    },
    "./blocks": {
      "types": "./src/blocks/index.ts",
      "default": "./src/blocks/index.ts"
    },
    "./link-preview": {
      "types": "./src/link-preview/index.ts",
      "default": "./src/link-preview/index.ts"
    },
    "./chips": {
      "types": "./src/chips/index.ts",
      "default": "./src/chips/index.ts"
    },
    "./tiptap": {
      "types": "./src/tiptap/index.ts",
      "default": "./src/tiptap/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djangocfg/widget-data": "workspace:*",
    "@djangocfg/widget-kit": "workspace:*",
    "@djangocfg/widget-map": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "lowlight": "^3.3.0",
    "tiptap-extension-global-drag-handle": "^0.1.18"
  },
  "peerDependencies": {
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
