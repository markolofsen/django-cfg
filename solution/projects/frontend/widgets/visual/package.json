{
  "name": "@djangocfg/widget-visual",
  "version": "0.1.24",
  "description": "Presentation pieces: a colour picker and palette, a marquee, a QR code, an image gallery and a Lottie player",
  "keywords": [
    "color-picker",
    "palette",
    "marquee",
    "qrcode",
    "gallery",
    "lottie",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/visual"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./color-picker": {
      "types": "./src/design/ColorPicker/index.ts",
      "default": "./src/design/ColorPicker/index.ts"
    },
    "./color-palette": {
      "types": "./src/design/ColorPalette/index.ts",
      "default": "./src/design/ColorPalette/index.ts"
    },
    "./marquee": {
      "types": "./src/marquee/index.ts",
      "default": "./src/marquee/index.ts"
    },
    "./qr-code": {
      "types": "./src/qrcode/index.ts",
      "default": "./src/qrcode/index.ts"
    },
    "./gallery": {
      "types": "./src/gallery/index.ts",
      "default": "./src/gallery/index.ts"
    },
    "./lottie-player": {
      "types": "./src/lottie/index.tsx",
      "default": "./src/lottie/index.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djangocfg/widget-kit": "workspace:*",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "qrcode": "^1.5.4",
    "react-lottie-player": "^2.1.0"
  },
  "peerDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
