{
  "name": "@djangocfg/widget-overlay",
  "version": "0.1.14",
  "description": "Surfaces that sit over the page: a responsive dialog, a scroll spy, a selection toolbar and a product tour",
  "keywords": [
    "dialog",
    "drawer",
    "scrollspy",
    "tour",
    "onboarding",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/overlay"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./responsive-dialog": {
      "types": "./src/responsive-dialog/index.ts",
      "default": "./src/responsive-dialog/index.ts"
    },
    "./scroll-spy": {
      "types": "./src/scroll-spy/index.ts",
      "default": "./src/scroll-spy/index.ts"
    },
    "./selection-toolbar": {
      "types": "./src/selection-toolbar/index.ts",
      "default": "./src/selection-toolbar/index.ts"
    },
    "./tour": {
      "types": "./src/tour/index.ts",
      "default": "./src/tour/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@djangocfg/widget-kit": "workspace:*"
  },
  "peerDependencies": {
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
