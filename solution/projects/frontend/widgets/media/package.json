{
  "name": "@djangocfg/widget-media",
  "version": "0.1.50",
  "description": "Media viewers for a conversation or a file preview: zoom/pan image lightbox, mermaid diagrams, markdown and code listings",
  "keywords": [
    "image-viewer",
    "lightbox",
    "mermaid",
    "markdown",
    "streamdown",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/media"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./image-viewer": "./src/image-viewer/index.ts",
    "./diagram": "./src/diagram/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./code": "./src/code/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@streamdown/code": "^2.0.0",
    "beautiful-mermaid": "^1.1.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "rehype-harden": "^1.1.8",
    "yet-another-react-lightbox": "^3.33.0",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "streamdown": "^2.6.0"
  },
  "devDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "streamdown": "2.7.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
