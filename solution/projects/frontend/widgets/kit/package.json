{
  "name": "@djangocfg/widget-kit",
  "version": "0.1.25",
  "description": "Shared ground for the djangocfg widgets: formatters, lazy-loading placeholders and the one code block (Prism) every surface must agree on",
  "keywords": [
    "formatters",
    "path",
    "bytes",
    "lazy",
    "suspense",
    "code-block",
    "prism",
    "syntax-highlighting",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "widgets/kit"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./format": {
      "types": "./src/format/index.ts",
      "default": "./src/format/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy/index.ts",
      "default": "./src/lazy/index.ts"
    },
    "./pretty-code": {
      "types": "./src/pretty-code/index.ts",
      "default": "./src/pretty-code/index.ts"
    },
    "./pretty-code/lazy": {
      "types": "./src/pretty-code/lazy.tsx",
      "default": "./src/pretty-code/lazy.tsx"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0"
  }
}
