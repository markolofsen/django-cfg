{
  "name": "@djangocfg/realtime",
  "version": "2.1.667",
  "description": "Browser half of django-cfg realtime: one lazy WebSocket per tab, reference-counted topics, replay and refetch-on-gap, React hooks and a debug panel.",
  "keywords": [
    "django",
    "realtime",
    "websocket",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "packages/realtime"
  },
  "bugs": {
    "url": "https://github.com/markolofsen/django-cfg/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "require": "./src/react/index.ts"
    },
    "./debug": {
      "types": "./src/debug/index.ts",
      "import": "./src/debug/index.ts",
      "require": "./src/debug/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "require": "./src/testing/index.ts"
    },
    "./styles": "./src/styles.css"
  },
  "files": [
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@djangocfg/api": {
      "optional": true
    },
    "@djangocfg/ui-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/eslint-config": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
