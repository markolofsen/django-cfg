      "default": "./dist/i18n/components.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "djangocfg-docs": "./dist/ai/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "ai-docs": "tsx src/ai/cli.ts"
  },
  "peerDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "next": "^16.4.5",
    "next-intl": "^4.9.1"
  },
  "peerDependenciesMeta": {
    "@djangocfg/api": {
      "optional": true
    },
    "@djangocfg/ui-core": {
      "optional": true
    },
    "@djangocfg/devtools": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "conf": "^16.0.0",
    "consola": "^3.4.2",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/layouts": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "@types/webpack": "^5.28.5",
    "eslint": "^10.14.0",
    "lucide-react": "^1.68.0",
    "next-intl": "^4.14.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
