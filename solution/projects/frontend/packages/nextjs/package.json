{
  "name": "@djangocfg/nextjs",
  "version": "2.1.667",
  "description": "Next.js server utilities: sitemap, health, OG images, contact forms, navigation, config",
  "keywords": [
    "nextjs",
    "sitemap",
    "health",
    "og-image",
    "navigation",
    "config",
    "react",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/markolofsen/django-cfg/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./sitemap": {
      "types": "./dist/sitemap/index.d.mts",
      "import": "./dist/sitemap/index.mjs",
      "default": "./dist/sitemap/index.mjs"
    },
    "./health": {
      "types": "./dist/health/index.d.mts",
      "import": "./dist/health/index.mjs",
      "default": "./dist/health/index.mjs"
    },
    "./human-check": {
      "types": "./dist/human-check/index.d.mts",
      "import": "./dist/human-check/index.mjs",
      "default": "./dist/human-check/index.mjs"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.mts",
      "import": "./dist/navigation/index.mjs",
      "default": "./dist/navigation/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs",
      "default": "./dist/config/index.mjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.mts",
      "import": "./dist/auth/index.mjs",
      "default": "./dist/auth/index.mjs"
    },
    "./auth/middleware": {
      "types": "./dist/auth/middleware.d.mts",
      "import": "./dist/auth/middleware.mjs",
      "default": "./dist/auth/middleware.mjs"
    },
    "./ai": {
      "types": "./dist/ai/index.d.mts",
      "import": "./dist/ai/index.mjs",
      "default": "./dist/ai/index.mjs"
