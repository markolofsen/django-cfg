    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@web3icons/react": "^4.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "countries-list": "^3.4.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "8.6.0",
    "i18n-iso-countries": "^7.14.0",
    "input-otp": "1.5.0",
    "libphonenumber-js": "^1.13.15",
    "react-day-picker": "10.0.2",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "3.0.6",
    "react-sticky-box": "^2.0.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/eslint-config": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "sonner": "2.0.8",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
