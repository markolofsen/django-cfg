{
  "name": "@djangocfg/ui-core",
  "version": "2.1.667",
  "description": "Pure React UI component library without Next.js dependencies - for Electron, Vite, CRA apps",
  "keywords": [
    "ui-components",
    "react",
    "radix-ui",
    "tailwindcss",
    "design-system",
    "component-library",
    "typescript",
    "electron",
    "vite"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "packages/ui-core"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "import": "./src/hooks/index.ts",
      "require": "./src/hooks/index.ts"
    },
    "./route-progress": {
      "types": "./src/route-progress/index.ts",
      "import": "./src/route-progress/index.ts",
      "require": "./src/route-progress/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts",
      "require": "./src/theme/index.ts"
    },
    "./adapters/nextjs": {
      "types": "./src/hooks/router/adapters/nextjs.tsx",
      "import": "./src/hooks/router/adapters/nextjs.tsx",
      "require": "./src/hooks/router/adapters/nextjs.tsx"
    },
    "./adapters/react-router": {
      "types": "./src/hooks/router/adapters/react-router.tsx",
      "import": "./src/hooks/router/adapters/react-router.tsx",
      "require": "./src/hooks/router/adapters/react-router.tsx"
    },
    "./chart": {
      "types": "./src/components/data/chart/index.tsx",
      "import": "./src/components/data/chart/index.tsx",
      "require": "./src/components/data/chart/index.tsx"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts",
      "require": "./src/lib/index.ts"
    },
    "./lib/dialog-service": {
      "types": "./src/lib/dialog-service/index.ts",
      "import": "./src/lib/dialog-service/index.ts",
      "require": "./src/lib/dialog-service/index.ts"
    },
    "./lib/speech-language": {
      "types": "./src/lib/speech-language/index.ts",
      "import": "./src/lib/speech-language/index.ts",
      "require": "./src/lib/speech-language/index.ts"
    },
    "./lib/pretext": {
      "types": "./src/lib/pretext/index.ts",
      "import": "./src/lib/pretext/index.ts",
      "require": "./src/lib/pretext/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./src/providers/index.ts",
      "require": "./src/providers/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    },
    "./styles": "./src/styles/css/index.css",
    "./styles/full": "./src/styles/css/full.css",
    "./styles/globals": "./src/styles/css/globals.css",
    "./styles/theme": "./src/styles/css/theme.css",
    "./styles/base": "./src/styles/css/base.css",
    "./styles/utilities": "./src/styles/css/utilities.css",
    "./styles/palette": {
      "types": "./src/styles/palette/index.ts",
      "import": "./src/styles/palette/index.ts",
      "require": "./src/styles/palette/index.ts"
    },
    "./styles/presets": {
      "types": "./src/styles/presets/index.ts",
      "import": "./src/styles/presets/index.ts",
      "require": "./src/styles/presets/index.ts"
    },
    "./styles/presets/default": "./src/styles/css/presets/default.css",
    "./styles/presets/django-cfg": "./src/styles/css/presets/django-cfg.css",
    "./styles/presets/ios": "./src/styles/css/presets/ios.css",
    "./styles/presets/macos": "./src/styles/css/presets/macos.css",
    "./styles/presets/windows": "./src/styles/css/presets/windows.css",
    "./styles/presets/soft": "./src/styles/css/presets/soft.css",
    "./styles/presets/dense": "./src/styles/css/presets/dense.css",
    "./styles/presets/high-contrast": "./src/styles/css/presets/high-contrast.css",
    "./styles/presets/notion": "./src/styles/css/presets/notion.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.{ts,tsx}",
    "!src/components/_gallery.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc --noEmit && node scripts/check-preset-contrast.mjs && node scripts/check-docs.mjs",
    "check:contrast": "node scripts/check-preset-contrast.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "consola": "^3.4.2",
    "lucide-react": "^1.68.0",
    "moment": "^2.30.1",
    "next": ">=14.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.69.0",
    "react-router": ">=7",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@hookform/resolvers": "^7.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
