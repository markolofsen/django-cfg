{
  "name": "@djangocfg/payments",
  "version": "2.1.667",
  "description": "Provider-agnostic React payments module (Stripe-first): checkout state machine, Payment Element wrapper, close-guard context, mock adapter for keyless development",
  "keywords": [
    "payments",
    "stripe",
    "checkout",
    "subscriptions",
    "payment-element",
    "react",
    "django",
    "typescript",
    "hooks"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "packages/payments"
  },
  "bugs": {
    "url": "https://github.com/markolofsen/django-cfg/issues"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./styles": "./src/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "@docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-stripe-imports.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1"
  },
  "peerDependencies": {
    "@djangocfg/ui-core": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@djangocfg/eslint-config": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "lucide-react": "1.68.0",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
