{
  "name": "@djangocfg/layouts",
  "version": "2.1.667",
  "description": "Simple, straightforward layout components for Next.js - import and use with props",
  "keywords": [
    "layouts",
    "dashboard",
    "admin-panel",
    "authentication",
    "nextjs",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "author": {
    "name": "DjangoCFG",
    "url": "https://djangocfg.com"
  },
  "homepage": "https://djangocfg.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/markolofsen/django-cfg.git",
    "directory": "packages/layouts"
  },
  "bugs": {
    "url": "https://github.com/markolofsen/django-cfg/issues"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "import": "./src/layouts/index.ts",
      "require": "./src/layouts/index.ts"
    },
    "./snippets": {
      "types": "./src/snippets/index.ts",
      "import": "./src/snippets/index.ts",
      "require": "./src/snippets/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./pages": {
      "types": "./src/pages/index.ts",
      "import": "./src/pages/index.ts",
      "require": "./src/pages/index.ts"
    },
    "./configurator": {
      "types": "./src/configurator/index.ts",
      "import": "./src/configurator/index.ts",
      "require": "./src/configurator/index.ts"
    },
    "./configurator/private": {
      "types": "./src/configurator/private/index.ts",
      "import": "./src/configurator/private/index.ts",
      "require": "./src/configurator/private/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts",
      "require": "./src/testing/index.ts"
    },
    "./styles": "./src/styles/index.css",
    "./styles/dashboard": "./src/styles/dashboard.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@djangocfg/analytics": "workspace:*",
    "@djangocfg/api": "workspace:*",
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/realtime": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@hookform/resolvers": "^5.2.2 || ^7.0.2",
    "@tanstack/react-query": "^5.108.2",
    "consola": "^3.4.2",
    "lucide-react": "^1.68.0",
    "moment": "^2.30.1",
    "next": "^16.4.5",
    "next-intl": "^4.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.69.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@djangocfg/devtools": {
      "optional": true
    }
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@djangocfg/analytics": "workspace:*",
    "@djangocfg/api": "workspace:*",
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/realtime": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@storybook/react-vite": "^10.6.5",
    "@tanstack/react-query": "5.108.2",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "next-intl": "^4.14.9",
    "sonner": "2.0.8",
    "storybook": "^10.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
