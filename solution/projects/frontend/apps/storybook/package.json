{
  "name": "@djangocfg/storybook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "kill-port": "lsof -ti:6017 | xargs kill -9 2>/dev/null || true",
    "dev": "pnpm kill-port && storybook dev -p 6017 --no-open",
    "build": "storybook build -o storybook-static",
    "preview": "npx serve storybook-static -p 6017",
    "check": "tsc --noEmit",
    "test": "pnpm test:stories:contracts",
    "test:stories:contracts": "vitest --project=storybook-contract --run",
    "test:stories:all": "vitest --project=storybook-all --run",
    "test:stories:watch": "vitest --project=storybook-contract"
  },
  "dependencies": {
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/layouts": "workspace:*",
    "@djangocfg/payments": "workspace:*",
    "@djangocfg/realtime": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@djangocfg/widget-chat": "workspace:*",
    "@djangocfg/widget-chat-dev": "workspace:*",
    "@djangocfg/widget-data": "workspace:*",
    "@djangocfg/widget-diagram": "workspace:*",
    "@djangocfg/widget-editor": "workspace:*",
    "@djangocfg/widget-map": "workspace:*",
    "@hookform/resolvers": "^7.0.2",
    "@rjsf/utils": "^6.11.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@djangocfg/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "aria-query": "5.3.2",
    "lz-string": "1.5.0",
    "playwright": "1.64.1",
    "postcss": "^8.5.32",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
