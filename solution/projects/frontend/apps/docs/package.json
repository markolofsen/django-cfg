{
  "name": "@djangocfg/docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "kill-port": "lsof -ti:3778 | xargs kill -9 2>/dev/null || true",
    "dev": "next dev -p 3778",
    "prebuild": "pnpm sitemap",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "next start -p 3778",
    "check": "tsc --noEmit",
    "seo": "tsx ../../packages/seo-engine/cli.ts",
    "sitemap": "tsx ../../packages/seo-engine/cli.ts sitemap",
    "check:links": "tsx ../../packages/seo-engine/cli.ts check",
    "check:external": "tsx ../../packages/seo-engine/cli.ts external",
    "fix:links": "tsx ../../packages/seo-engine/cli.ts fix --write",
    "postbuild:pagefind": "pagefind --site .next/server/app --output-path public/_pagefind"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@nextra/seo-engine": "workspace:*",
    "@theguild/remark-mermaid": "^0.3.0",
    "lucide-react": "1.68.0",
    "mermaid": "^12.3.0",
    "next": "16.4.5",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-lottie-player": "2.1.0"
  }
}
