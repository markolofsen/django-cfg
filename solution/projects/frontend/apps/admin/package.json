{
  "name": "@djangocfg/admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ai-docs": "djangocfg-docs",
    "seo:audit": "pnpm exec djangocfg-seo audit --output @reports/seo",
    "pwa": "djangocfg-pwa",
    "kill-port": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev": "next dev",
    "build": "next build",
    "build:static": "NEXT_PUBLIC_STATIC_BUILD=true next build",
    "build:docker": "next build",
    "check-types": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "check": "tsc --noEmit",
    "i18n:check": "i18n check -d ./i18n/locales",
    "i18n:list": "i18n list -d ./i18n/locales",
    "i18n:sync": "i18n sync -d ./i18n/locales",
    "i18n:translate": "i18n translate -d ./i18n/locales"
  },
  "dependencies": {
    "@djangocfg/api": "^2.1.465",
