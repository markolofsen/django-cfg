    "@djangocfg/layouts": "^2.1.465",
    "@djangocfg/monitor": "^2.1.457",
    "@djangocfg/ui-core": "^2.1.465",
    "@djangocfg/ui-tools": "^2.1.465",
    "@hookform/resolvers": "^5.4.0",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.545.0",
