  "components": {
    "schemas": {
      "CoinListing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "symbol": {
            "type": "string",
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "id",
          "name",
          "symbol",
          "updated_at"
        ]
      },
      "CoinListingWrite": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          }
        },
        "required": [
          "name",
          "symbol"
        ]
      },
      "CoinListingWriteRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          }
        },
        "required": [
          "name",
          "symbol"
        ]
      },
      "DemoPing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "note": {
            "type": "string",
            "readOnly": true
          },
          "signed_in": {
            "type": "boolean",
            "readOnly": true,
            "description": "True when a signed-in user sent it"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "created_at",
          "id",
          "note",
          "signed_in"
        ]
      },
      "DemoPingSendRequestRequest": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "default": "",
            "maxLength": 200
          }
        }
      },
      "PaginatedCoinListingList": {
        "type": "object",
        "required": [
          "count",
          "page",
          "pages",
          "page_size",
          "has_next",
          "has_previous",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of items across all pages",
            "example": 150
          },
          "page": {
