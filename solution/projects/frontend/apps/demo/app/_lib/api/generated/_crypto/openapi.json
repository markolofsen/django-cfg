          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "description": "A unique integer value identifying this coin listing.",
            "required": true
          }
        ],
        "tags": [
          "crypto"
        ],
        "security": [
          {
            "apiKeyAuth": []
          },
          {
            "jwtAuthWithLastLogin": []
          },
          {
            "tokenAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoinListing"
                }
              }
            },
            "description": ""
          }
        },
        "x-async-capable": false
      },
      "put": {
