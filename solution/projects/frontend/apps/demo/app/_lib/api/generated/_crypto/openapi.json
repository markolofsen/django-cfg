            "schema": {
              "type": "integer"
            },
            "description": "A unique integer value identifying this coin listing.",
            "required": true
          }
        ],
        "tags": [
          "crypto"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoinListingWriteRequest"
              }
