  "paths": {
    "/apix/crypto/coins/": {
      "get": {
        "operationId": "crypto_coins_list",
        "description": "Get a paginated list of all coin listings ordered by market cap.",
        "summary": "List coin listings",
        "parameters": [
          {
            "name": "ordering",
            "required": false,
            "in": "query",
            "description": "Which field to use when ordering the results.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "A page number within the paginated result set.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "required": false,
            "in": "query",
            "description": "Number of results to return per page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "A search term.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "crypto"
        ],
        "security": [
          {
            "apiKeyAuth": []
          },
          {
            "jwtAuthWithLastLogin": []
          },
          {
            "tokenAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedCoinListingList"
                }
              }
            },
            "description": ""
          }
        },
        "x-async-capable": false
      },
      "post": {
        "operationId": "crypto_coins_create",
        "description": "Create a new coin listing.",
        "summary": "Create coin listing",
        "tags": [
          "crypto"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoinListingWriteRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "apiKeyAuth": []
          },
          {
            "jwtAuthWithLastLogin": []
          },
          {
            "tokenAuth": []
          },
          {}
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoinListingWrite"
                }
              }
            },
            "description": ""
          }
        },
        "x-async-capable": false
      }
    },
