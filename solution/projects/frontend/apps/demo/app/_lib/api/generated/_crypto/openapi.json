  "components": {
    "schemas": {
      "CoinListing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "symbol": {
            "type": "string",
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "id",
          "name",
          "symbol",
          "updated_at"
        ]
      },
      "CoinListingWrite": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          }
        },
        "required": [
          "name",
          "symbol"
        ]
      },
      "CoinListingWriteRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          }
        },
        "required": [
          "name",
          "symbol"
        ]
      },
      "PaginatedCoinListingList": {
        "type": "object",
        "required": [
          "count",
          "page",
          "pages",
          "page_size",
          "has_next",
          "has_previous",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of items across all pages",
            "example": 150
          },
          "page": {
            "type": "integer",
            "description": "Current page number (1-based)",
            "example": 2
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages",
            "example": 15
          },
          "page_size": {
            "type": "integer",
            "description": "Number of items per page",
            "example": 10
          },
          "has_next": {
            "type": "boolean",
            "description": "Whether there is a next page",
            "example": true
          },
          "has_previous": {
            "type": "boolean",
            "description": "Whether there is a previous page",
            "example": true
          },
          "next_page": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Next page number (null if no next page)",
            "example": 3
          },
          "previous_page": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Previous page number (null if no previous page)",
            "example": 1
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoinListing"
            },
            "description": "Array of items for current page"
          }
        }
      },
      "PatchedCoinListingWriteRequest": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          },
          "market_cap": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "pattern": "^-?\\d{0,13}(?:\\.\\d{0,2})?$"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      },
      "jwtAuthWithLastLogin": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Token-based authentication with required prefix \"Token\""
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ]
}