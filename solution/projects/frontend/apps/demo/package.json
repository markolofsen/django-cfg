{
  "name": "@djangocfg/demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ai-docs": "djangocfg-docs",
    "pwa": "djangocfg-pwa",
    "kill-port": "lsof -ti:3010 | xargs kill -9 2>/dev/null || true",
    "dev": "next dev --port 3010",
    "build": "pnpm check && next build",
    "build:static": "NEXT_PUBLIC_STATIC_BUILD=true next build",
    "build:docker": "next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "i18n:check": "i18n check -d ./i18n/locales",
    "i18n:list": "i18n list -d ./i18n/locales",
    "i18n:sync": "i18n sync -d ./i18n/locales",
    "i18n:translate": "i18n translate -d ./i18n/locales"
  },
  "dependencies": {
    "@djangocfg/api": "workspace:*",
    "@djangocfg/devtools": "workspace:*",
    "@djangocfg/i18n": "workspace:*",
    "@djangocfg/layouts": "workspace:*",
    "@djangocfg/realtime": "workspace:*",
    "@djangocfg/ui-core": "workspace:*",
    "@djangocfg/widget-ogimage": "workspace:*",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-query": "5.108.2",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "msw": "3.0.7"
  },
  "devDependencies": {
    "@djangocfg/nextjs": "workspace:*",
    "@djangocfg/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
